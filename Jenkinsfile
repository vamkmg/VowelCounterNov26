
// Defines a Declarative Jenkins Pipeline.
pipeline {

    // Runs the pipeline on any available Jenkins agent.
    agent any

    // Defines the external tools required by the pipeline.
    tools {

        // Selects the JDK installation named JDK21 in Jenkins Global Tool Configuration.
        jdk 'JDK27'

        // Selects the Maven installation named Maven3 in Jenkins Global Tool Configuration.
        maven 'Maven3.10.1'

    // Ends the tools configuration block.
    }

    // Defines the stages that Jenkins executes in sequence.
    stages {

        // Stage 1: Retrieves the source code from GitHub.
        stage('Checkout') {

            // Defines the operations performed during the Checkout stage.
            steps {

                // Checks out the source code using the repository and branch configured in the Jenkins job.
                checkout scm

            // Ends the steps block.
            }

        // Ends the Checkout stage.
        }

        // Stage 2: Verifies that Java, Maven and Git are available.
        stage('Check Tools') {

            // Defines the operations performed during the Check Tools stage.
            steps {

                // Displays the installed Java version.
                bat 'java -version'

                // Displays the installed Maven version.
                bat 'mvn -version'

                // Displays the installed Git version.
                bat 'git --version'

            // Ends the steps block.
            }

        // Ends the Check Tools stage.
        }

        // Stage 3: Compiles the source code, executes tests and packages the application.
        stage('Build and Test') {

            // Defines the operations performed during the Build and Test stage.
            steps {

                // Runs Maven in batch mode.
                // clean removes files generated by previous builds.
                // verify compiles the code, runs tests, packages the application
                // and executes the verification steps in the Maven lifecycle.
                bat 'mvn -B clean verify'

            // Ends the steps block.
            }

        // Ends the Build and Test stage.
        }

        // Stage 4: Archives the generated executable JAR file in Jenkins.
        stage('Archive Application') {

            // Defines the operations performed during the Archive Application stage.
            steps {

                // Archives the generated JAR files from the target directory.
                archiveArtifacts(

                    // Selects all JAR files in the Maven target directory.
                    artifacts: 'target/*.jar',

                    // Calculates and stores fingerprints to help track artifacts across builds.
                    fingerprint: true

                // Ends the archiveArtifacts configuration.
                )

            // Ends the steps block.
            }

        // Ends the Archive Application stage.
        }

    // Ends the stages block.
    }

    // Defines actions that Jenkins performs after the stages finish.
    post {

        // Executes the following action regardless of whether the build succeeds or fails.
        always {

            // Collects and publishes JUnit test results in Jenkins.
            junit(

                // Specifies the location of the JUnit XML reports generated by Maven Surefire.
                testResults: 'target/surefire-reports/*.xml',

                // Prevents a missing test report from causing an additional pipeline failure.
                // This does not mean that the tests have passed.
                allowEmptyResults: true

            // Ends the junit configuration.
            )

        // Ends the always block.
        }

        // Executes the following action when the pipeline succeeds.
        success {

            // Displays a success message in the Jenkins console output.
            echo 'Room Management build completed successfully!'

        // Ends the success block.
        }

        // Executes the following action when the pipeline fails.
        failure {

            // Displays a failure message and directs the user to the Jenkins console logs.
            echo 'Room Management build failed. Check the Jenkins console logs.'

        // Ends the failure block.
        }

    // Ends the post block.
    }

// Ends the Declarative Jenkins Pipeline.
}
